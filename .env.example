# 네이버 계정. NAVER_BLOG_ID는 로그인 아이디와 발행 블로그의 기본값이다.
# 로그인 아이디와 글을 쓸 블로그가 다르면 아래 두 값을 따로 둔다.
NAVER_BLOG_ID=your_naver_id
NAVER_BLOG_PASSWORD=your_password
# NAVER_LOGIN_ID=your_login_id
# NAVER_PUBLISH_BLOG_ID=your_blog_id

# Playwright 설정
HEADLESS=true  # false로 설정하면 브라우저가 보임 (디버깅용)
SLOW_MO=0      # 액션 사이 딜레이 (ms), 디버깅 시 100-500 권장

# 로깅 레벨
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR
